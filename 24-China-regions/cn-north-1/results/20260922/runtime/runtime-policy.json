{
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "ecr:GetAuthorizationToken"
        ],
        "Resource": "*"
      },
      {
        "Effect": "Allow",
        "Action": [
          "ecr:BatchGetImage",
          "ecr:GetDownloadUrlForLayer"
        ],
        "Resource": "arn:aws-cn:ecr:cn-north-1:447150580482:repository/cn-runtime24-ec55b7f117"
      },
      {
        "Effect": "Allow",
        "Action": [
          "logs:DescribeLogGroups"
        ],
        "Resource": "arn:aws-cn:logs:cn-north-1:447150580482:log-group:*"
      },
      {
        "Effect": "Allow",
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:DescribeLogStreams",
          "logs:PutLogEvents"
        ],
        "Resource": "arn:aws-cn:logs:cn-north-1:447150580482:log-group:/aws/bedrock-agentcore/runtimes/cn_runtime24_ec55b7f117*"
      }
    ]
  }
}
