{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws-cn:s3:::cn-ec2-bench-0eec9b6240-447150580482/input/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws-cn:s3:::cn-ec2-bench-0eec9b6240-447150580482/results/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeAgentRuntime",
        "bedrock-agentcore:StopRuntimeSession"
      ],
      "Resource": "arn:aws-cn:bedrock-agentcore:cn-north-1:447150580482:runtime/cn_runtime24_ec55b7f117_*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:StartCodeInterpreterSession",
        "bedrock-agentcore:InvokeCodeInterpreter",
        "bedrock-agentcore:StopCodeInterpreterSession",
        "bedrock-agentcore:GetCodeInterpreterSession",
        "bedrock-agentcore:ListCodeInterpreterSessions",
        "bedrock-agentcore:GetCodeInterpreter"
      ],
      "Resource": [
        "arn:aws-cn:bedrock-agentcore:cn-north-1:aws:code-interpreter/aws.codeinterpreter.v1",
        "arn:aws-cn:bedrock-agentcore:cn-north-1:447150580482:code-interpreter/aws.codeinterpreter.v1"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws-cn:ecr:cn-north-1:447150580482:repository/cn-runtime24-ec55b7f117"
    },
    {
      "Effect": "Allow",
      "Resource": [
        "arn:aws-cn:bedrock-agentcore:cn-north-1:447150580482:code-interpreter-custom/cn_runtime24_ec55b7f117_public-X94BdJdLva",
        "arn:aws-cn:bedrock-agentcore:cn-north-1:447150580482:code-interpreter/cn_runtime24_ec55b7f117_public-X94BdJdLva",
        "arn:aws-cn:bedrock-agentcore:cn-north-1:447150580482:code-interpreter-custom/cn_ci_efs_53c6d40f78-eXhLPXpSHB",
        "arn:aws-cn:bedrock-agentcore:cn-north-1:447150580482:code-interpreter/cn_ci_efs_53c6d40f78-eXhLPXpSHB"
      ],
      "Action": [
        "bedrock-agentcore:StartCodeInterpreterSession",
        "bedrock-agentcore:InvokeCodeInterpreter",
        "bedrock-agentcore:StopCodeInterpreterSession",
        "bedrock-agentcore:GetCodeInterpreterSession",
        "bedrock-agentcore:ListCodeInterpreterSessions",
        "bedrock-agentcore:GetCodeInterpreter"
      ]
    }
  ]
}
