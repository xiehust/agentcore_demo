#!/bin/bash
set -eu
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /run /tmp /workspace /home/dsh
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
modprobe -a virtio_pci virtio_net vmw_vsock_virtio_transport nsm
ip link set lo up
ip addr add 192.0.2.2/30 dev eth0
ip link set eth0 up
ip route add default via 192.0.2.1
echo 'nameserver 169.254.169.253' > /etc/resolv.conf
export BENCH_RUN_ID=unknown
for arg in $(</proc/cmdline); do
    case "$arg" in bench_id=*) export BENCH_RUN_ID="${arg#bench_id=}" ;; esac
done
export DSH_HOME=/home/dsh/.dsh DSH_WORKDIR=/workspace
# PID 1 remains alive; no model access or DSH process is prewarmed at boot.
exec /usr/local/bin/node /opt/dsh/server.mjs
