# Claude-compatible endpoint
ANTHROPIC_BASE_URL=https://your-claude-compatible-endpoint.example
ANTHROPIC_API_KEY=replace-me

# Langfuse (LANGFUSE_HOST is also accepted instead of LANGFUSE_BASE_URL)
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# AWS credentials use the standard AWS credential chain.
AWS_REGION=us-west-2
